# Copiar a web/.env solo en la máquina local. .env no se versiona.
# Django lee estas variables del entorno del proceso; este archivo es la referencia.

# Clave de firma de sesiones y CSRF. Cambiarla fuera de esta máquina.
DJANGO_SECRET_KEY=cambiar-por-una-clave-local

# 1 en desarrollo local. 0 si el proceso no es de depuración.
DJANGO_DEBUG=1

# Lista separada por comas. El servidor de desarrollo escucha en 127.0.0.1.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Servicio local. No publicar este puerto.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# No se sustituye por otro modelo si este no está instalado.
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Tope de la espera de una inferencia, en segundos.
OLLAMA_TIMEOUT_S=60

# Tope de tokens generados en una respuesta.
OLLAMA_NUM_PREDICT=512
