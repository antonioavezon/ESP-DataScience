# Plantilla de configuración de HUC 1.0.0. No contiene secretos.
# ./instalar.sh genera .env automáticamente con claves aleatorias.
# Configuración manual:  cp .env.example .env  y completar los campos vacíos.

# Prefijo de contenedores, red y volúmenes (cámbielo para correr una segunda copia aislada).
COMPOSE_PROJECT_NAME=huc
HUC_VERSION=1.0.0

# Secreto de Django: cadena aleatoria larga. Ej.: openssl rand -base64 32
DJANGO_SECRET_KEY=
# Nombres/IP con los que se accederá a la web (separados por coma).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
# Orígenes que pueden enviar formularios. Deben coincidir con los puertos publicados.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8001,http://127.0.0.1:8000,http://127.0.0.1:8001,https://*.trycloudflare.com

# Credenciales del operador del simulador (puerto DATA). Defina una clave propia.
HUC_SIM_USUARIO=operador
HUC_SIM_CLAVE=

# Modelo lingüístico local (se descarga solo en el primer arranque, ~2,5 GB).
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Direcciones internas de la red Docker (no requieren cambios).
HUC_MQTT_HOST=huc-mqtt
HUC_MQTT_PORT=1883
HUC_IA_URL=http://huc-ia:8002
OLLAMA_BASE_URL=http://huc-ollama:11434

# Publicación en el anfitrión. HUC_BIND=127.0.0.1 limita el acceso al propio equipo.
HUC_BIND=0.0.0.0
HUC_PUERTO_WEB=8000
HUC_PUERTO_DATA=8001
